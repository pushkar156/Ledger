rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to ensure user owns the document
    function isOwner() {
      return isAuthenticated() && (
        (resource == null && request.resource.data.user_id == request.auth.uid) ||
        (resource != null && resource.data.user_id == request.auth.uid)
      );
    }

    match /expenses/{expenseId} {
      allow read, write: if isOwner();
    }

    match /budgets/{budgetId} {
      allow read, write: if isOwner();
    }

    match /savings/{savingsId} {
      allow read, write: if isOwner();
    }

    match /recurring_expenses/{ruleId} {
      allow read, write: if isOwner();
    }
  }
}
